{
  "title": "EuroTransit / Inventory Correctness",
  "description": "KEEP IN SYNC with EuroTransit-configuration platform/kube-prometheus-stack/dashboards/inventory-correctness.configmap.yaml. A local dashboard that measures inventory correctness differently from production creates blind spots.",
  "uid": "eurotransit-inventory-correctness",
  "tags": ["eurotransit", "inventory", "correctness"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "title": "Hold Operations (Success vs Rejected vs Expired)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(inventory_holds_successful_total[5m]))",
          "legendFormat": "Successful Holds/s"
        },
        {
          "expr": "sum(rate(inventory_holds_rejected_total[5m]))",
          "legendFormat": "Rejected Holds/s"
        },
        {
          "expr": "sum(rate(inventory_holds_expired_total[5m]))",
          "legendFormat": "Expired Holds/s"
        }
      ]
    },
    {
      "title": "Post-Hold Transitions (Confirmed vs Refunded)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(inventory_holds_confirmed_total[5m]))",
          "legendFormat": "Confirmed Sales/s"
        },
        {
          "expr": "sum(rate(inventory_holds_refunded_total[5m]))",
          "legendFormat": "Refunded Seats/s"
        }
      ]
    },
    {
      "title": "Idempotency Hits (Duplicate Request Protection)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(inventory_idempotency_hits_total[5m]))",
          "legendFormat": "Idempotency Hits/s"
        }
      ]
    },
    {
      "title": "Oversell & Invariant Violations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(orders_reconciliation_required_total{kind=\"INVARIANT_VIOLATION\"}[5m]))",
          "legendFormat": "Invariant Violations"
        },
        {
          "expr": "sum(increase(orders_inventory_confirm_total{code=\"RESERVATION_SEAT_CONFLICT\"}[5m]))",
          "legendFormat": "Seat Conflicts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Invariant Violations" },
            "properties": [ { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "Seat Conflicts" },
            "properties": [ { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } } ]
          }
        ]
      }
    },
    {
      "title": "Payment Window Transitions (T2 Timer)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (result) (rate(inventory_holds_payment_window_total[5m]))",
          "legendFormat": "Inventory Window: {{result}}"
        },
        {
          "expr": "sum by (result) (rate(orders_inventory_payment_window_total[5m]))",
          "legendFormat": "Orders -> Window: {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      }
    },
    {
      "title": "Background Maintenance & Cleanup",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(inventory_holds_sweep_errors_total[5m]))",
          "legendFormat": "Hold Sweep Errors"
        },
        {
          "expr": "sum(increase(inventory_idempotency_purge_errors_total[5m]))",
          "legendFormat": "Idempotency Purge Errors"
        },
        {
          "expr": "sum(rate(inventory_idempotency_purged_total[5m]))",
          "legendFormat": "Purged Idempotency Records/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Hold Sweep Errors" },
            "properties": [ { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "Idempotency Purge Errors" },
            "properties": [ { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } } ]
          }
        ]
      }
    }
  ]
}
