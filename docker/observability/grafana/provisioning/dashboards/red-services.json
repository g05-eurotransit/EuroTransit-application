{
  "title": "EuroTransit / RED — Services",
  "description": "KEEP IN SYNC with EuroTransit-configuration platform/kube-prometheus-stack/dashboards/red-services.configmap.yaml. A local dashboard that measures service health differently from production creates blind spots.",
  "uid": "eurotransit-red-services",
  "tags": ["eurotransit", "red", "services"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      },
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(http_server_requests_seconds_count{namespace=\"eurotransit\"}, app)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "label": "Service"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Rate",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Request rate (req/s) by service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{namespace=\"eurotransit\", app=~\"$app\"}[5m]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by status class",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{namespace=\"eurotransit\", app=~\"$app\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "5xx error ratio by service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.02 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{namespace=\"eurotransit\", app=~\"$app\", status=~\"5..\"}[5m])) / clamp_min(sum by (app) (rate(http_server_requests_seconds_count{namespace=\"eurotransit\", app=~\"$app\"}[5m])), 0.0001)",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "4xx error ratio by service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{namespace=\"eurotransit\", app=~\"$app\", status=~\"4..\"}[5m])) / clamp_min(sum by (app) (rate(http_server_requests_seconds_count{namespace=\"eurotransit\", app=~\"$app\"}[5m])), 0.0001)",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Duration",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le, app) (rate(http_server_requests_seconds_bucket{namespace=\"eurotransit\", app=~\"$app\"}[5m])))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p99 by service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le, app) (rate(http_server_requests_seconds_bucket{namespace=\"eurotransit\", app=~\"$app\"}[5m])))",
          "legendFormat": "{{app}}"
        }
      ]
    }
  ]
}
