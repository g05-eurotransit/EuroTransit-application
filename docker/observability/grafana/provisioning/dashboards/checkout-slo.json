{
  "title": "EuroTransit / Checkout SLO — Money Path",
  "description": "KEEP IN SYNC with EuroTransit-configuration platform/kube-prometheus-stack/dashboards/checkout-slo.configmap.yaml. A local dashboard that measures checkout differently from production is not an accurate rehearsal for production.",
  "uid": "eurotransit-checkout-slo",
  "tags": ["eurotransit", "slo", "checkout"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Checkout success rate (30m) — SLO 99%",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.99 }, { "color": "green", "value": 0.995 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "1 - (sum(rate(http_server_requests_seconds_count{namespace=\"eurotransit\", app=\"orders\", uri=~\"/api/orders.*\", status=~\"5..\"}[30m])) / clamp_min(sum(rate(http_server_requests_seconds_count{namespace=\"eurotransit\", app=\"orders\", uri=~\"/api/orders.*\"}[30m])), 0.0001))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Accept latency p99 (POST /api/orders) — SLO 300ms",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.3 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"eurotransit\", app=\"orders\", method=\"POST\", uri=~\"/api/orders\"}[5m])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Checkout p95 latency — SLO 2s",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 2 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"eurotransit\", app=\"orders\", uri=~\"/api/orders.*\"}[15m])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkout 5xx ratio (mirrors CheckoutFastBurn alert, threshold 2%)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.02 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"eurotransit\", app=\"orders\", uri=~\"/api/orders.*\", status=~\"5..\"}[10m])) / clamp_min(sum(rate(http_server_requests_seconds_count{namespace=\"eurotransit\", app=\"orders\", uri=~\"/api/orders.*\"}[10m])), 0.0001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkout pipeline duration p95 (orders.checkout.duration)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orders_checkout_duration_seconds_bucket{namespace=\"eurotransit\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orders_checkout_duration_seconds_bucket{namespace=\"eurotransit\"}[5m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Notifications events consumed (rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(notifications_events_consumed_total{namespace=\"eurotransit\"}[5m]))",
          "legendFormat": "consumed/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag (KafkaPipelineStalled > 100)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 100 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag{namespace=\"eurotransit\"})",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    }
  ]
}
